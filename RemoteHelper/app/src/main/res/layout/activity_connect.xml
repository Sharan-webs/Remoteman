<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Code entry -->
    <LinearLayout
        android:id="@+id/entrySection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/codeInput"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:hint="@string/connect_hint"
            android:inputType="number"
            android:maxLength="6"
            android:gravity="center"
            android:textSize="22sp"
            android:letterSpacing="0.3"
            android:background="@drawable/bg_card"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:layout_marginBottom="20dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitCode"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Connect"
            android:textAllCaps="false"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/accent"/>
    </LinearLayout>

    <!-- Connecting / connected -->
    <LinearLayout
        android:id="@+id/sessionSection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:alpha="0">

        <LinearLayout
            android:id="@+id/connectingLabel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_loader_ring"
                android:id="@+id/connectLoader"
                android:layout_marginBottom="14dp"/>

            <TextView
                android:id="@+id/connectStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connecting"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"/>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/videoContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="6"
            android:background="#000000"
            android:visibility="gone">

            <org.webrtc.SurfaceViewRenderer
                android:id="@+id/remoteView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <ImageButton
                android:id="@+id/btnFullscreen"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:background="@drawable/bg_fullscreen_btn"
                android:src="@android:drawable/ic_menu_crop"
                android:contentDescription="Full screen"/>
        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLeaveServer"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_margin="16dp"
            android:text="@string/btn_leave_server"
            android:textAllCaps="false"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/status_red"/>

    </LinearLayout>

</FrameLayout>

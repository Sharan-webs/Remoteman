<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_main">

    <!-- Top-left corner Stop button -->
    <ImageButton
        android:id="@+id/btnCornerStop"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="top|start"
        android:layout_margin="20dp"
        android:background="@drawable/bg_pill_red"
        android:src="@android:drawable/ic_media_pause"
        android:contentDescription="Stop"
        android:elevation="4dp"/>

    <!-- Top-right settings gear -->
    <ImageButton
        android:id="@+id/btnSettings"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="top|end"
        android:layout_margin="20dp"
        android:background="@drawable/bg_icon_circle"
        android:src="@android:drawable/ic_menu_manage"
        android:contentDescription="Settings"/>

    <!-- Ambient rotating ring, anchored at the bottom corner -->
    <ImageView
        android:id="@+id/ambientRing"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-90dp"
        android:layout_marginBottom="-90dp"
        android:src="@drawable/ic_loader_ring"
        android:alpha="0.18"
        android:contentDescription="@null"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:id="@+id/appTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RemoteMan"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-black"
            android:textSize="34sp"
            android:letterSpacing="-0.01"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Remote screen access, simplified"
            android:textColor="@color/text_faint"
            android:fontFamily="sans-serif-medium"
            android:textSize="13sp"
            android:letterSpacing="0.04"
            android:layout_marginBottom="52dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHost"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/btn_host"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="18dp"
            app:backgroundTint="@color/accent"
            app:elevation="0dp"
            android:layout_marginBottom="16dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/btn_connect"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="18dp"
            app:backgroundTint="@android:color/transparent"
            app:strokeColor="@color/accent"
            app:strokeWidth="1.4dp"
            app:elevation="0dp"/>

    </LinearLayout>
</FrameLayout>
